{
  "name": "ares-solo-automa",
  "private": true,
  "description": "Unofficial solo automa for Terraforming Mars: Ares Expedition — rules, print & play cards and a companion PWA.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node scripts/build-site.mjs",
    "check": "tsc -p jsconfig.json",
    "lint:lit": "lit-analyzer \"app/lit/components/*.js\"",
    "test": "npm run check && node --test \"app/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "lit": "3.3.1",
    "lit-analyzer": "2.0.3",
    "typescript": "5.9.3"
  }
}
